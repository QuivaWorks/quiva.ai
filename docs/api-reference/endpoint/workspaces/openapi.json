          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "record_config_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default_record_config_id": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SpaceList": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Space"
            }
          },
          "results_total": {
            "type": "integer"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "readOnly": true
          },
          "url": {
            "type": "string",
            "readOnly": true,
            "description": "UI URL to navigate directly to this task"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Markdown / rich-text content"
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "Assigned user IDs."
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "created_by": {
            "type": "string",
            "readOnly": true
          },
          "priority": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "reporter": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "space_id": {
            "type": "string"
          },
          "due_date": {
            "type": "string"
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC3339 date-time at which the task is scheduled. Archiving the task clears it."
          },
          "archived": {
            "type": "boolean",
            "description": "Whether the task is archived."
          },
          "order": {
            "type": "number",
            "description": "Sort order of the task within its column/board."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Free-form tag ids on the task."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Arbitrary metadata bag stored on the task."
          },
          "watchers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "readOnly": true,
            "description": "User ids watching the task. Only present on the get-task response, not stored on the task record."
          },
          "muted": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "readOnly": true,
            "description": "User ids who muted the task. Only present on the get-task response."
          }
        }
      },
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Markdown / rich-text content"
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true,
            "description": "Assigned user IDs."
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "priority": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "reporter": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Initial status id. If omitted and `space_id` is set, the task inherits the space's `default_status`."
          },
          "space_id": {
            "type": "string",
            "description": "Parent space id. If omitted, the task lands in the default space. The task id is server-generated; any id you send is ignored."
          },
          "due_date": {
            "type": "string",
            "format": "date-time",
            "description": "RFC3339 date-time. A date-only value can fail to round-trip."
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time",
            "description": "RFC3339 date-time to schedule the task."
          },
          "archived": {
            "type": "boolean",
            "description": "Create the task in an archived state."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Free-form tag ids."
          }
        }
      },
      "UpdateTaskRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CreateTaskRequest"
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {
                "type": "string"
              },
              "archived": {
