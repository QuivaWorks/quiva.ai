          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Action id (assigned by the server unless you supplied one on create).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Action deleted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
