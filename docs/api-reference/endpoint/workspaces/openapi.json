    "/workspaces/task/{task_id}/action": {
      "put": {
        "summary": "Create or update a task checklist action",
        "description": "Upsert a checklist action on a task. There is no separate create endpoint \u2014 PUT is used for both create and update.\n\nOmit `id` to create a new action (the server assigns one); pass an existing `id` to update that action. `description` is required on every write, including updates that only change `done`.\n\nThe response echoes back the action as submitted, not the stored record \u2014 it does not reflect how a partial update merged with the existing action.",
        "operationId": "setTaskAction",
        "tags": [
          "Task Actions"
        ],
        "x-resource-type": "service",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "Task id the action hangs off.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskAction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The action as submitted (echoed back, not read back from storage).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskAction"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "get": {
        "summary": "List task checklist actions \u2014 currently unavailable",
        "description": "Intended to return the checklist actions on a task, but this endpoint is currently misrouted server-side and always responds with a 400 validation error instead of a list.\n\nUntil this is fixed, checklist actions are write-only: keep track of the `id` you get back when you create or update an action, since it cannot be listed or read back afterward.",
        "operationId": "listTaskActions",
        "deprecated": true,
        "tags": [
          "Task Actions"
        ],
        "x-resource-type": "service",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "description": "Task id the action hangs off.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of checklist actions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TaskAction"
                      }
                    },
                    "results_total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/workspaces/task/{task_id}/action/{id}": {
      "delete": {
        "summary": "Delete a task checklist action",
