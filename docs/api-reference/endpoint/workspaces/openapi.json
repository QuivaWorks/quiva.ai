{
  "openapi": "3.0.3",
  "info": {
    "title": "Workspaces Service API",
    "version": "1.0.0",
    "description": "API for managing workspaces, tasks, and comments"
  },
  "servers": [
    {
      "url": "https://api.quiva.ai",
      "description": "Production API server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    },
    {
      "apiKeyAuth": []
    }
  ],
  "paths": {
    "/workspaces/spaces": {
      "get": {
        "summary": "List all spaces",
        "description": "Returns every space in the account. The response always includes a built-in `ESCALATE` space (used for human-in-the-loop escalations from flows); it cannot be updated or deleted.",
        "operationId": "listSpaces",
        "x-resource-type": "service",
        "responses": {
          "200": {
            "description": "List of spaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpaceList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/workspaces/space": {
      "post": {
        "summary": "Create a space",
        "operationId": "createSpace",
        "x-resource-type": "service",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSpaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created space",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Space"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
    "/workspaces/space/{id}": {
      "get": {
        "summary": "Get a space by ID",
        "operationId": "getSpace",
        "x-resource-type": "service",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Space",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Space"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "summary": "Update a space",
        "description": "Merges the fields you send over the stored space \u2014 send only the fields you are changing. The built-in `ESCALATE` space cannot be updated and returns 403.",
        "operationId": "updateSpace",
        "x-resource-type": "service",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateSpaceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated space",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Space"
                }
              }
            }
          },
          "202": {
            "description": "Update accepted, with a background re-assignment queued. This happens when a priority you removed was still in use by existing tasks \u2014 those tasks are reassigned to the fallback priority (the space's default, or the first remaining one)."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "summary": "Delete a space",
        "description": "Deletes a space and purges its tasks, comments, and files. Irreversible. The built-in `ESCALATE` space cannot be deleted and returns 403.",
        "operationId": "deleteSpace",
        "x-resource-type": "service",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Space deleted"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/workspaces/space/{space_id}/tasks": {
      "get": {
        "summary": "List tasks in a space",
        "operationId": "listTasks",
        "x-resource-type": "service",
        "parameters": [
                {
                    "name": "space_id",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "archived",
                    "in": "query",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "name": "scheduled",
                    "in": "query",
                    "schema": {
                        "type": "boolean"
                    }
                },
                {
                    "name": "limit",
                    "in": "query",
                    "description": "How many maximum results should be returned",
                    "schema": {
                        "type": "integer",
                        "default": 300
                    }
                },
                {
                    "name": "offset",
                    "in": "query",
                    "description": "If there are more results than the limit, offset can be used to get to the next batch of results",
                    "schema": {
                        "type": "integer",
                        "default": 0
                    }
                },
                {
                    "name": "sort_by",
                    "in": "query",
                    "description": "Name of the field used for sorting the list of results",
                    "schema": {
                        "type": "string",
                        "default": "created_at"
                    }
                },
                {
                    "name": "sort_order",
                    "in": "query",
                    "description":"Should the results be sorted in ascending or descending order relative to sort_by field",
                    "schema": {
                        "type": "string",
                        "enum": [
                            "asc",
                            "desc"
                        ],
                        "default": "asc"
                    }
                },
                {
                    "name": "created_by",
                    "in": "query",
                    "description": "Exact match on the user ID of the task creator",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "priority",
                    "in": "query",
                    "description": "Exact match on priority; comma-separated values to filter by priority",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "status",
                    "in": "query",
                    "description": "Exact match on status; comma-separated values to filter by multiple statuses",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "title",
                    "in": "query",
                    "description": "Term search on task title",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "assignees",
                    "in": "query",
                    "description": "Comma-separated assignee IDs; at least one must match",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "reporter",
                    "in": "query",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "created_at",
                    "in": "query",
                    "description": "Filter by creation date. Use a single date or a range as `{start_date},{end_date}`",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "updated_at",
                    "in": "query",
                    "description": "Filter by last-updated date. Use a single date or a range as `{start_date},{end_date}`",
                    "schema": {
                        "type": "string"
                    }
                },
                {
                    "name": "scheduled_at",
                    "in": "query",
                    "description": "Filter by scheduled date. Use a single date or a range as `{start_date},{end_date}`",
                    "schema": {
                        "type": "string"
                    }
                }
        ],
        "responses": {
          "200": {
            "description": "List of tasks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          }
        }
      }
    },
