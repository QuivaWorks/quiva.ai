        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "results_total": {
            "type": "integer"
          }
        }
      },
      "TaskAction": {
        "type": "object",
        "required": [
          "description"
        ],
        "description": "A checklist item on a task. `description` is required on every write, not only on create \u2014 an update that only flips `done` still has to resend it.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Action id. Omit on create and the server assigns one; pass an existing id to update that action.",
            "example": "ta_a1b2c3"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the action is. Required on every write.",
            "example": "Confirm the report has been proofread"
          },
          "done": {
            "type": "boolean",
            "description": "Whether the item is ticked off."
          },
          "resources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskActionResource"
            },
            "description": "Platform resources linked from this action."
          }
        }
      },
      "TaskActionResource": {
        "type": "object",
        "required": [
          "resource_id",
          "resource_type"
        ],
        "description": "A platform resource linked from a checklist action. Both fields are free-form strings \u2014 the resource is not validated to exist.",
        "properties": {
          "resource_id": {
            "type": "string",
            "example": "onboarding-checklist"
          },
          "resource_type": {
            "type": "string",
            "example": "record-config"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "description": "Free-form metadata carried alongside the link."
          }
        }
      },
      "Comment": {
        "type": "object",
